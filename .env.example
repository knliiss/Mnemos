COMPOSE_PROJECT_NAME=mnemos
MNEMOS_HOST_BIND_ADDRESS=127.0.0.1

# Images
POSTGRES_VERSION=17-alpine
KEYCLOAK_VERSION=26.7.0
KAFKA_VERSION=4.3.0
REDIS_VERSION=8.8.0-alpine
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# Application PostgreSQL
APP_POSTGRES_DB=mnemos
APP_POSTGRES_HOST_PORT=5433
APP_POSTGRES_USER=mnemos
APP_POSTGRES_PASSWORD=change_me
APP_DATASOURCE_URL=jdbc:postgresql://app-postgres:5432/mnemos
APP_DATASOURCE_MAX_POOL_SIZE=5
APP_DATASOURCE_MIN_IDLE=1

# Application service PostgreSQL roles
ACCOUNT_POSTGRES_USER=mnemos_account
ACCOUNT_POSTGRES_PASSWORD=replace_me
WALLET_POSTGRES_USER=mnemos_wallet
WALLET_POSTGRES_PASSWORD=replace_me
EVENT_POSTGRES_USER=mnemos_event
EVENT_POSTGRES_PASSWORD=replace_me
NOTIFICATION_POSTGRES_USER=mnemos_notification
NOTIFICATION_POSTGRES_PASSWORD=replace_me
REWARD_POSTGRES_USER=mnemos_reward
REWARD_POSTGRES_PASSWORD=replace_me
BET_POSTGRES_USER=mnemos_bet
BET_POSTGRES_PASSWORD=replace_me
MODERATION_POSTGRES_USER=mnemos_moderation
MODERATION_POSTGRES_PASSWORD=replace_me
REALTIME_POSTGRES_USER=mnemos_realtime
REALTIME_POSTGRES_PASSWORD=replace_me
PERSONALIZATION_POSTGRES_USER=mnemos_personalization
PERSONALIZATION_POSTGRES_PASSWORD=replace_me
SOCIAL_POSTGRES_USER=mnemos_social
SOCIAL_POSTGRES_PASSWORD=replace_me
PROFILE_POSTGRES_USER=mnemos_profile
PROFILE_POSTGRES_PASSWORD=replace_me

# Keycloak PostgreSQL
KEYCLOAK_POSTGRES_HOST_PORT=5434
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=change_me

# Keycloak
KEYCLOAK_HOST_PORT=8079
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_ROOT_LOG_LEVEL=INFO
TELEGRAM_AUTH_LOG_LEVEL=INFO

# Keycloak config CLI
KEYCLOAK_CONFIG_CLI_VERSION=6.5.1-26.5.5

# Keycloak service clients
MNEMOS_ACCOUNT_SERVICE_CLIENT_ID=account-service-admin
KEYCLOAK_ACCOUNT_SERVICE_CLIENT_SECRET=change_me
MNEMOS_MODERATION_SERVICE_CLIENT_ID=moderation-service-admin
KEYCLOAK_MODERATION_SERVICE_CLIENT_SECRET=change_me

# Kafka
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=29093
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_BROKER_PASSWORD=change_me
KAFKA_ADMIN_PASSWORD=change_me
KAFKA_TLS_STORE_PASSWORD=change_me
KAFKA_ACCOUNT_SERVICE_PASSWORD=change_me
KAFKA_WALLET_SERVICE_PASSWORD=change_me
KAFKA_EVENT_SERVICE_PASSWORD=change_me
KAFKA_NOTIFICATION_SERVICE_PASSWORD=change_me
KAFKA_REWARD_SERVICE_PASSWORD=change_me
KAFKA_BET_SERVICE_PASSWORD=change_me
KAFKA_MODERATION_SERVICE_PASSWORD=change_me
KAFKA_GATEWAY_SERVICE_PASSWORD=change_me
KAFKA_REALTIME_SERVICE_PASSWORD=change_me
KAFKA_PERSONALIZATION_SERVICE_PASSWORD=change_me
KAFKA_SOCIAL_SERVICE_PASSWORD=change_me
KAFKA_PROFILE_SERVICE_PASSWORD=change_me
MNEMOS_KAFKA_MANAGE_TOPICS=false

# Kafka message authentication
ACCOUNT_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
WALLET_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
EVENT_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
NOTIFICATION_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
REWARD_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
BET_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
MODERATION_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
GATEWAY_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
REALTIME_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
PERSONALIZATION_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
SOCIAL_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
PROFILE_SERVICE_KAFKA_SIGNING_PRIVATE_KEY=
MNEMOS_KAFKA_TRUSTED_PUBLIC_KEYS=

# Redis
REDIS_HOST_PORT=6379
REDIS_PASSWORD=change_me
REDIS_MAXMEMORY=512mb

# MinIO
MINIO_ROOT_USER=mnemos
MINIO_ROOT_PASSWORD=change_me
MINIO_PERSONALIZATION_BUCKET=mnemos-personalization
MINIO_PERSONALIZATION_ACCESS_KEY=mnemos-personalization
MINIO_PERSONALIZATION_SECRET_KEY=change_me_personalization

# Telegram
MNEMOS_TELEGRAM_BOT_TOKEN=
NOTIFICATION_TELEGRAM_ENABLED=false
MNEMOS_TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
MNEMOS_SUPER_ADMIN_TELEGRAM_ID=

# Origins
MNEMOS_FRONTEND_ORIGIN=https://mnemos.example.com
MNEMOS_API_ORIGIN=https://api.mnemos.example.com
MNEMOS_AUTH_ORIGIN=https://auth.mnemos.example.com

# Cristalix
CRISTALIX_API_URL=https://api.cristalix.gg
CRISTALIX_ACCOUNT_SERVICE_PROJECT_TOKEN=
CRISTALIX_ACCOUNT_SERVICE_PROJECT_KEY=

# Account service
ACCOUNT_SERVICE_VERSION=local

# Wallet service
WALLET_SERVICE_VERSION=local
WALLET_SERVICE_ACCOUNT_API_KEY=replace_me

# Event service
EVENT_SERVICE_VERSION=local
EVENT_SERVICE_ACCOUNT_API_KEY=replace_me

# Notification service
NOTIFICATION_SERVICE_VERSION=local

# Reward service
REWARD_SERVICE_VERSION=local
REWARD_SERVICE_ACCOUNT_API_KEY=replace_me

# Bet service
BET_SERVICE_VERSION=local
BET_SERVICE_ACCOUNT_API_KEY=replace_me
BET_SERVICE_EVENT_API_KEY=replace_me

# Moderation service
MODERATION_SERVICE_VERSION=local
GATEWAY_MODERATION_API_KEY=replace_me
MODERATION_SERVICE_WALLET_API_KEY=replace_me

# Gateway
GATEWAY_SERVICE_VERSION=local
GATEWAY_HOST_PORT=8080
MNEMOS_REALTIME_FORWARDING_TOKEN=change_me

# Realtime service
REALTIME_SERVICE_VERSION=local
REALTIME_SERVICE_ACCOUNT_API_KEY=replace_me

# Personalization service
PERSONALIZATION_SERVICE_VERSION=local
PERSONALIZATION_SERVICE_ACCOUNT_API_KEY=replace_me
MNEMOS_PERSONALIZATION_CREATOR_PRIME_SHARE_PERCENT=70
MNEMOS_PERSONALIZATION_CREATOR_COIN_SHARE_PERCENT=50
MNEMOS_PERSONALIZATION_CREATOR_COIN_PER_PRIME=100
MNEMOS_PERSONALIZATION_CREATOR_REVENUE_RETRY_DELAY=30s
MNEMOS_PERSONALIZATION_CREATOR_REVENUE_RETRY_BATCH_SIZE=100
MNEMOS_PERSONALIZATION_CREATOR_RETRY_SCAN_DELAY_MS=10000

# Social service
SOCIAL_SERVICE_VERSION=local
SOCIAL_SERVICE_ACCOUNT_API_KEY=replace_me
SOCIAL_SERVICE_EVENT_API_KEY=replace_me
SOCIAL_SERVICE_PERSONALIZATION_API_KEY=replace_me
SPOTLIGHT_PRICE_PRIME=25
SPOTLIGHT_DROP_MAX_AGE=2h
SPOTLIGHT_LIFETIME=1h
SPOTLIGHT_BUYER_COOLDOWN=20m
SPOTLIGHT_GLOBAL_GAP=15s
SPOTLIGHT_RECIPIENT_GAP=30s
SPOTLIGHT_MAX_QUEUE_DELAY=5m

# Profile service
PROFILE_SERVICE_VERSION=local
PROFILE_SERVICE_ACCOUNT_API_KEY=replace_me
PROFILE_BOOTSTRAP_BATCH_SIZE=200
PROFILE_BOOTSTRAP_DELAY_MS=2000
PROFILE_SOCIAL_RECONCILIATION_DELAY_MS=5000
