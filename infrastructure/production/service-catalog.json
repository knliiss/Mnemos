      "kind": "infrastructure",
      "image": "mnemos-keycloak",
      "dockerfile": "infrastructure/keycloak/Dockerfile",
      "context": ".",
      "gradle_task": ":keycloak-extensions:telegram-authenticator:jar",
      "build_args": {
        "KEYCLOAK_VERSION": "KEYCLOAK_VERSION"
      },
      "deploy": {
        "type": "compose",
        "name": "mnemos-keycloak"
      }
    },
